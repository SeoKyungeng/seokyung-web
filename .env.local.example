# 네이버 SMTP (문의 폼 이메일 발송)
# 네이버 메일 > 환경설정 > POP3/IMAP 설정 > IMAP/SMTP 사용 켜기 필요
# 2단계 인증 사용 시 앱 비밀번호 발급 필요
SMTP_USER=
SMTP_PASS=

# Vercel 배포 시: Settings > Environment Variables에 위 값 등록

# ─────────────────────────────────────────────
# Sanity CMS
# ─────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Viewer (read-only) token — Next.js 런타임 조회용
SANITY_API_TOKEN=

# Sanity 웹훅 서명 검증용
SANITY_REVALIDATE_SECRET=
